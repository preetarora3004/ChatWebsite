{
   "compilerOptions": {
      "rootDir": "./src",
      "outDir": "./dist",
      "declaration": true,
      "target": "ES2023",
      "paths": {
         "@repo/db/*": [
            "../db/src/*"
         ],
         "@repo/utils/*": [
            "../utils/src/*"
         ]
      },
      "module": "esnext",
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "isolatedModules": true,
      "strict": true
   },
   "include": [
      "src",
      "../types/**/*.d.ts",
      "../utils/src/**/*.ts"
   ],
   "exclude": [
      "dist",
      "build",
      "node_modules"
   ]
}
