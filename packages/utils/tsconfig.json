{
   "compilerOptions": {
      "declaration": true,
      "target": "ES2020",
      "paths": {
         "@repo/db/*": [
            "../db/src/*"
         ]
      },
      "module": "esnext",
      "noEmit": true,
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "allowImportingTsExtensions": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "isolatedModules": true,
      "strict": true
   },
   "include": [
      "src",
      "../types/**/*.d.ts",
      "../db/src/**/*.ts"
   ],
   "exclude": [
      "dist",
      "build",
      "node_modules"
   ]
}
