{
   "extends": "../typescript-config/react-library.json",
   "compilerOptions": {
      "rootDir": "src",
      "outDir": "dist",
      "allowArbitraryExtensions": true,
      "paths": {
         "@/*": [
            "./src/*"
         ]
      }
   },
   "include": [
      "src",
      "../types/**/*.d.ts"
   ],
   "exclude": [
      "dist",
      "build",
      "node_modules"
   ]
}
