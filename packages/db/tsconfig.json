{
   "compilerOptions": {
      "module": "NodeNext",
      "ignoreDeprecations": "6.0",
      "target": "ES2023",
      "declaration": true,
      "moduleResolution": "node16",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "isolatedModules": true,
      "strict": true
   }
}

