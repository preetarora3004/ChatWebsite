{
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "ignoreDeprecations": "6.0",
    "target": "ES2023",
    "declaration" : true,
    "moduleResolution" : "bundler",
    "esModuleInterop": true,                  
    "allowSyntheticDefaultImports": true,     
    "skipLibCheck": true,                    
    "forceConsistentCasingInFileNames": true, 
    "isolatedModules": true,
    "strict": true
  },
  "include": ["./src/**/*.ts", "./*.ts"]
}



