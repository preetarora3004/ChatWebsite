generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum ChatType {
    GROUP
    SINGLE
}

model User {
    id String @id @default(cuid())

    email    String
    username String
    password String

    lastSeen LastSeen?

    chatMembers ChatMembers[]
    messages    Message[]
    sessions    Session[]

    createdAt DateTime @default(now())

    @@unique([email])
    @@unique([username])
}

model Session {
    id String @id @default(cuid())

    token String @unique
    hashToken String  @unique
    isActive  Boolean @default(true)

    user   User   @relation(fields: [userId], references: [id])
    userId String

    createdAt DateTime @default(now())
    expiredAt DateTime
}

model Chat {
    id String @id @default(cuid())

    name String?
    type ChatType @default(SINGLE)

    chatMembers ChatMembers[]
    messages    Message[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ChatMembers {
    id String @id @default(cuid())

    user   User   @relation(fields: [userId], references: [id])
    userId String

    chat   Chat   @relation(fields: [chatId], references: [id])
    chatId String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, chatId])   
}

model Message {
    id String @id @default(cuid())

    content String

    sender   User   @relation(fields: [senderId], references: [id])
    senderId String

    chat   Chat   @relation(fields: [chatId], references: [id])
    chatId String

    createdAt DateTime @default(now())

    @@index([chatId])
    @@index([content])
    @@index([senderId])
}

model LastSeen {
    id String @id @default(cuid())

    lastOnline Int

    user   User   @relation(fields: [userId], references: [id])
    userId String @unique
}
