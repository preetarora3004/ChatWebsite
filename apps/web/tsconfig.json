{
   "extends": "@repo/typescript-config/nextjs.json",
   "compilerOptions": {
      "plugins": [
         {
            "name": "next"
         }
      ],
      "target": "es2023",
      "allowArbitraryExtensions": true,
      "module": "esnext",
      "moduleResolution": "bundler",
      "declaration": true,
      "paths": {
         "@repo/ui/*": [
            "../../packages/ui/src/*"
         ],
         "@repo/ui": [
            "packages/ui/src/*"
         ],
         "@repo/db": [
            "../../packages/src/**/*.ts"
         ]
      }
   },
   "include": [
      "./app",
      "./*.css",
      "**/*.ts",
      "**/*.tsx",
      "next-env.d.ts",
      "next.config.ts",
      ".next/types/**/*.ts",
      "../../packages/db/src/**/*.ts",
      "../../packages/types/next-auth.d.ts"
   ],
   "exclude": [
      "node_modules"
   ]
}
