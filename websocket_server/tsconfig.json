{
   "compilerOptions": {
      "target": "es2023",
      "module": "ESNext",
      "moduleResolution": "nodenext",
      "declaration": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true
   },
   "include": [
      "./src",
      "../packages/db/src/**/*.ts"
   ],
   "exclude": [
      "node_modules",
      "dist"
   ]
}
